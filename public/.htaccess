# Meditron CDC — Next.js static export on cPanel
Options -Indexes
DirectorySlash Off
ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# 1) Real files (css / js / images / .html) are served as-is.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 2) /path/ (trailing slash) -> path.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ $1.html [L]

# 3) /path (no trailing slash, no extension) -> path.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# 4) If a directory exists with index.html inside, serve it
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]
